# ==========================================
# TENNIS FANTASY - BACKEND ENVIRONMENT VARIABLES
# ==========================================
# INSTRUCTIONS:
# 1. Copy this file to a new file named ".env"
# 2. Enter your actual keys in the ".env" file
# 3. The ".env" file is ignored by git, so your secrets are safe
# 4. Restart the backend after changing these values

# ------------------------------
# SPORTS RADAR API (Required)
# ------------------------------
# Get key from: https://developer.sportradar.com
SPORTRADAR_API_KEY=your_sportradar_api_key_here

# ------------------------------
# SUPABASE CONFIGURATION (Required)
# ------------------------------
# Project Settings -> Database
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password

# Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ------------------------------
# OPTIONAL OVERRIDES
# ------------------------------
# server.port=8080
# logging.level.root=INFO
